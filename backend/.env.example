# Copie este arquivo para .env e preencha:  cp .env.example .env
# NUNCA commite o .env (já está no .gitignore)

# String de conexão do Postgres (Supabase: Settings → Database → Connection string → URI)
DATABASE_URL=postgres://usuario:senha@host:5432/postgres

# Porta do server
PORT=3000

# Margem mínima aceitável (%) — abaixo disso o checkout bloqueia e o sync alerta
MIN_MARGIN_PERCENT=15

# Sync: falhas consecutivas antes de pausar um produto
SYNC_MAX_FAILURES=3
SYNC_BATCH_SIZE=50
SYNC_CONCURRENCY=5

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# SigiloPay (gateway de pagamentos, cobranças Pix)
SIGILOPAY_PUBLIC_KEY=
SIGILOPAY_SECRET_KEY=

# Asaas (gateway de pagamentos, cobranças Pix) — Sandbox por enquanto
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=
ASAAS_API_KEY=

# Token das rotas /admin/* (header x-admin-token). Gere um valor forte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
